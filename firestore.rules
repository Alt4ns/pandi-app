rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'alt4ns@icloud.com'
        && request.auth.token.email_verified == true;
    }

    function ownsTicket(requestId) {
      return signedIn()
        && get(/databases/$(database)/documents/DestekTalepleri/$(requestId)).data.uid == request.auth.uid;
    }

    function ownsTicketAfter(requestId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/DestekTalepleri/$(requestId)).data.uid == request.auth.uid;
    }

    function validStatus(value) {
      return value in ['new', 'in_progress', 'resolved'];
    }

    function isPostOwner(postId) {
      return signedIn()
        && get(/databases/$(database)/documents/ForumPaylasimlari/$(postId)).data.paylasanKullaniciID == request.auth.uid;
    }

    function validPostCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'begeniSayisi', 'yorumSayisi', 'kaydetmeSayisi'
        ])
        && request.resource.data.begeniSayisi is int
        && request.resource.data.yorumSayisi is int
        && request.resource.data.kaydetmeSayisi is int
        && request.resource.data.begeniSayisi >= 0
        && request.resource.data.yorumSayisi >= 0
        && request.resource.data.kaydetmeSayisi >= 0
        && request.resource.data.begeniSayisi >= resource.data.begeniSayisi - 1
        && request.resource.data.begeniSayisi <= resource.data.begeniSayisi + 1
        && request.resource.data.yorumSayisi >= resource.data.yorumSayisi - 1
        && request.resource.data.yorumSayisi <= resource.data.yorumSayisi + 1
        && request.resource.data.kaydetmeSayisi >= resource.data.kaydetmeSayisi - 1
        && request.resource.data.kaydetmeSayisi <= resource.data.kaydetmeSayisi + 1;
    }

    function validCommentCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begeniSayisi'])
        && request.resource.data.begeniSayisi is int
        && request.resource.data.begeniSayisi >= 0
        && request.resource.data.begeniSayisi >= resource.data.begeniSayisi - 1
        && request.resource.data.begeniSayisi <= resource.data.begeniSayisi + 1;
    }

    // Pandi iOS oturum akisi Firebase Authentication sonrasinda bu belgeyi
    // okur. Destek merkezi kurallari eklenirken bu eslesme kaybolursa dogru
    // sifreyle giris yapilsa bile uygulama "insufficient permissions" verir.
    match /kullanicilar/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.kimlik == request.auth.uid
        && !request.resource.data.keys().hasAny(['adminMi', 'rol']);

      allow update: if isAdmin()
        || signedIn()
        && request.auth.uid == userId
        && request.resource.data.kimlik == resource.data.kimlik
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'adminMi', 'rol', 'rolGuncellenmeTarihi', 'roluGuncelleyenKullaniciID'
        ]);

      allow delete: if false;

      // Notlar, belirtiler, rozetler, cihaz tokenlari ve engellenenler gibi
      // kullaniciya ait alt koleksiyonlar yalnizca hesap sahibi tarafindan
      // erisilebilir. Yonetici destek/denetim amaciyla okuyabilir.
      match /{subCollection}/{documentId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Pandi Forum: oturum acmis kullanicilar icerigi okuyabilir; kimlik,
    // sahiplik ve sayac guncellemeleri sunucu kurallariyla sinirlanir.
    match /ForumPaylasimlari/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.paylasimID == postId
        && request.resource.data.paylasanKullaniciID == request.auth.uid
        && request.resource.data.baslik is string
        && request.resource.data.baslik.size() >= 1
        && request.resource.data.baslik.size() <= 160
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() >= 1
        && request.resource.data.mesaj.size() <= 5000
        && request.resource.data.begeniSayisi == 0
        && request.resource.data.yorumSayisi == 0
        && request.resource.data.kaydetmeSayisi == 0;

      allow update: if isAdmin() || (signedIn() && validPostCounterUpdate());
      allow delete: if isAdmin() || resource.data.paylasanKullaniciID == request.auth.uid;

      match /begeniler/{userId} {
        allow read: if signedIn()
          && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.kullaniciID == request.auth.uid;
        allow delete: if signedIn()
          && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
        allow update: if false;
      }

      match /kaydedenler/{userId} {
        allow read: if signedIn()
          && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.kullaniciID == request.auth.uid;
        allow delete: if signedIn()
          && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
        allow update: if false;
      }

      match /yorumlar/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.yorumID == commentId
          && request.resource.data.yorumcuKullaniciID == request.auth.uid
          && request.resource.data.mesaj is string
          && request.resource.data.mesaj.size() >= 1
          && request.resource.data.mesaj.size() <= 3000
          && request.resource.data.begeniSayisi == 0;

        allow update: if isAdmin() || (signedIn() && validCommentCounterUpdate());
        allow delete: if signedIn()
          && (resource.data.yorumcuKullaniciID == request.auth.uid
            || isPostOwner(postId)
            || isAdmin());

        match /begeniler/{userId} {
          allow read: if signedIn()
            && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
          allow create: if signedIn()
            && userId == request.auth.uid
            && request.resource.data.kullaniciID == request.auth.uid;
          allow delete: if signedIn()
            && (userId == request.auth.uid || isPostOwner(postId) || isAdmin());
          allow update: if false;
        }
      }
    }

    // Pandi Kulup icerikleri tum oturum acmis uyelere gorunur. Icerik
    // yonetimi yalnizca yoneticiye, yorum olusturma ise yorum sahibine aittir.
    match /PandiKulupIcerikleri/{contentId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yorumSayisi'])
        && request.resource.data.yorumSayisi is int
        && request.resource.data.yorumSayisi == resource.data.yorumSayisi + 1;

      match /yorumlar/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.yorumId == commentId
          && request.resource.data.gonderiId == contentId
          && request.resource.data.kullaniciId == request.auth.uid
          && request.resource.data.metin is string
          && request.resource.data.metin.size() >= 1
          && request.resource.data.metin.size() <= 3000
          && request.resource.data.begeniSayisi == 0;
        allow update: if isAdmin();
        allow delete: if isAdmin()
          || signedIn() && resource.data.kullaniciId == request.auth.uid;
      }
    }

    // Bildirimler kullanici bazinda sorgulanir. Alici yalnizca kendi
    // bildirimlerini okuyabilir, okundu durumunu degistirebilir ve silebilir.
    match /Bildirimler/{notificationId} {
      allow read: if isAdmin()
        || signedIn() && resource.data.kullaniciID == request.auth.uid;

      allow create: if isAdmin()
        || signedIn()
        && request.resource.data.kullaniciID == request.auth.uid
        && request.resource.data.bildirimID == notificationId
        || signedIn()
        && request.resource.data.etkilesimKullaniciID == request.auth.uid
        && request.resource.data.bildirimID == notificationId
        && request.resource.data.kullaniciID != request.auth.uid;

      allow update: if isAdmin()
        || signedIn()
        && resource.data.kullaniciID == request.auth.uid
        && request.resource.data.kullaniciID == resource.data.kullaniciID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'okundu', 'okunmaTarihi'
        ])
        && request.resource.data.okundu is bool;

      allow delete: if isAdmin()
        || signedIn() && resource.data.kullaniciID == request.auth.uid;
    }

    // Topluluk sikayetleri kullanici tarafindan olusturulur; tum listeyi ve
    // moderasyon durumunu yalnizca yonetici gorebilir ve degistirebilir.
    match /Sikayetler/{reportId} {
      allow create: if signedIn()
        && request.resource.data.bildirenKullaniciID == request.auth.uid;
      allow read: if isAdmin()
        || signedIn() && resource.data.bildirenKullaniciID == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /DestekTalepleri/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'authProvider', 'category', 'message', 'status',
          'source', 'createdAt', 'updatedAt', 'lastMessage',
          'lastMessageAt', 'lastSender'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.authProvider is string
        && request.resource.data.authProvider.size() >= 3
        && request.resource.data.authProvider.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.category.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.status == 'new'
        && request.resource.data.lastSender == 'user'
        && request.resource.data.source == 'pandi-web';

      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSender'
        ])
        && validStatus(request.resource.data.status)
        || signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSender'
        ])
        && request.resource.data.lastSender == 'user'
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.status in ['new', 'in_progress'];

      allow delete: if false;

      match /Mesajlar/{messageId} {
        allow read: if isAdmin() || ownsTicket(requestId);
        allow create: if request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 2
          && request.resource.data.text.size() <= 3000
          && (
            isAdmin()
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'admin'
            || ownsTicketAfter(requestId)
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'user'
          );
        allow update, delete: if false;
      }
    }

    match /mail/{mailId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['ticketId', 'to', 'createdAt', 'message'])
        && request.resource.data.ticketId is string
        && request.resource.data.to == get(/databases/$(database)/documents/DestekTalepleri/$(request.resource.data.ticketId)).data.email
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.html is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
